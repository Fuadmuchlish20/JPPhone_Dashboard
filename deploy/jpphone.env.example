# JPPhone server settings. install-app.sh copies this to /etc/jpphone.env (readable only by root and the service).
# systemd reads this file: wrap JSON values in single quotes so their double quotes survive.
# After editing: sudo systemctl restart jpphone

# --- basics ---------------------------------------------------------------
APP_URL=https://your-domain.com
HOST=127.0.0.1
PORT=8787
COOKIE_SECURE=1
TRUST_PROXY=1
# Long random secret for the admin API (install-app.sh fills this in).
ADMIN_TOKEN=

# --- phones -----------------------------------------------------------------
# mock = no real phones (for trying the dashboard); redroid = real Android containers.
ENGINE=mock
# Phones on another machine (a dashboard-only server + one ARM phone host over WireGuard):
#   REGION_HOSTS='{"*": {"docker": "ssh://deploy@10.8.0.2", "adb": "10.8.0.2", "bind": "10.8.0.2"}}'
# Phones on this same machine: leave REGION_HOSTS empty.
REGION_HOSTS='{}'
# Android versions you sell, if a tag differs from redroid/redroid:<v>.0.0-latest:
#   REDROID_IMAGES='{"15": "redroid/redroid:15.0.0_64only-latest"}'
REDROID_GPU_MODE=guest
SCRCPY_VERSION=3.1
# Days an expired phone is kept (powered off) before it and its data are deleted.
EXPIRE_GRACE_DAYS=7

# --- payments (Midtrans) ----------------------------------------------------
# Empty = top-ups wait for admin confirmation.
MIDTRANS_SERVER_KEY=
# 1 = live payments; empty = sandbox.
MIDTRANS_PRODUCTION=
USD_TO_IDR=16000

# --- email (one of the two) -------------------------------------------------
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM="JPPhone <no-reply@your-domain.com>"
# Defaults to 1 once email is configured: no top-ups / new phones until the email is confirmed.
#REQUIRE_VERIFIED_EMAIL=1

# --- latency probes per region (Caddyfile.ping on each region host) --------
REGION_PING='{}'

# --- misc -------------------------------------------------------------------
SIGNUP_GEMS=0
MAX_UPLOAD_MB=2048
